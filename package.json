{
	"name": "scammesh",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "Cross-channel scam defense powered by concurrent agents. Hackathon prototype / no real financial actions.",
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"dev": "concurrently -k \"npm:dev:server\" \"npm:dev:ui\"",
		"dev:server": "tsx watch src/server/index.ts",
		"dev:ui": "vite",
		"build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
		"start": "tsx src/server/index.ts",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
		"test": "vitest run",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"dependencies": {
		"@mozaik-ai/core": "^4.0.5",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"lucide-react": "^1.41.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tsx": "^4.23.13"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/express": "^5.0.6",
		"@types/node": "^26.4.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"@vitejs/plugin-react": "^6.1.1",
		"concurrently": "^10.0.5",
		"eslint": "^10.10.0",
		"globals": "^17.12.0",
		"prettier": "^3.9.6",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.69.0",
		"vite": "^8.2.2",
		"vitest": "^5.0.0"
	}
}
