{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": false,
		"outDir": "dist/server",
		"rootDir": "src",
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"types": ["node"]
	},
	"include": [
		"src/server/**/*.ts",
		"src/runtime/**/*.ts",
		"src/agents/**/*.ts",
		"src/inference/**/*.ts",
		"src/risk/**/*.ts",
		"src/scenarios/**/*.ts",
		"src/shared/**/*.ts"
	],
	"exclude": ["src/**/*.test.ts", "src/ui/**"]
}
