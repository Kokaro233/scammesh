{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": false,
		"outDir": "dist/server",
		"rootDir": "src/server",
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"types": ["node"]
	},
	"include": ["src/server/**/*.ts"],
	"exclude": ["src/server/**/*.test.ts"]
}
